<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · Pennywise</title><link rel="stylesheet" href="${ctx}/assets/css/app.css"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head><body>
<%@ include file="nav.jspf" %><main class="main"><div class="page-head"><div><p class="eyebrow">OVERVIEW</p><h1>Good day, <c:out value="${name}"/>.</h1><p class="muted">Here's your financial snapshot.</p></div><a class="btn primary" href="${ctx}/transactions">＋ Add transaction</a></div>
<section class="stats"><article class="stat balance"><span>Total balance</span><strong>₹ <c:out value="${balance}"/></strong><small>Income minus expenses</small></article><article class="stat"><span>Total income</span><strong class="green">₹ <c:out value="${income}"/></strong><small>All recorded income</small></article><article class="stat"><span>Total expenses</span><strong class="red">₹ <c:out value="${expense}"/></strong><small>All recorded spending</small></article></section>
<section class="chart-grid"><article class="panel"><div class="panel-head"><div><h2>Cash flow</h2><p class="muted">Income vs expenses · recent 6 months</p></div></div><div class="chart-wrap"><canvas id="flowChart"></canvas></div></article><article class="panel"><div class="panel-head"><div><h2>Spending breakdown</h2><p class="muted">By expense category</p></div></div><div class="chart-wrap doughnut"><canvas id="categoryChart"></canvas></div></article></section>
<section class="panel"><div class="panel-head"><div><h2>Recent activity</h2><p class="muted">Your latest recorded transactions</p></div><a href="${ctx}/transactions">View all →</a></div><div class="table-scroll"><table><thead><tr><th>Description</th><th>Type</th><th>Date</th><th class="right">Amount</th></tr></thead><tbody><c:forEach items="${recent}" var="t"><tr><td><strong><c:out value="${t.title}"/></strong></td><td><span class="pill"><c:out value="${t.kind}"/></span></td><td><c:out value="${t.tx_date}"/></td><td class="right">₹ <c:out value="${t.amount}"/></td></tr></c:forEach><c:if test="${empty recent}"><tr><td colspan="4" class="empty">No transactions yet. Add your first income or expense.</td></tr></c:if></tbody></table></div></section>
</main><script>
const months=[<c:forEach items="__EL_16__" var="x" varStatus="s"><c:if test="__EL_17__">,</c:if>"<c:out value='__EL_18__'/>"</c:forEach>];
const ins=[<c:forEach items="__EL_19__" var="x" varStatus="s"><c:if test="__EL_20__">,</c:if><c:out value="__EL_21__"/></c:forEach>];
const outs=[<c:forEach items="__EL_22__" var="x" varStatus="s"><c:if test="__EL_23__">,</c:if><c:out value="__EL_24__"/></c:forEach>];
const cats=[<c:forEach items="__EL_25__" var="x" varStatus="s"><c:if test="__EL_26__">,</c:if>"<c:out value='__EL_27__'/>"</c:forEach>];
const vals=[<c:forEach items="__EL_28__" var="x" varStatus="s"><c:if test="__EL_29__">,</c:if><c:out value="__EL_30__"/></c:forEach>];
new Chart(document.getElementById('flowChart'),{type:'bar',data:{labels:months,datasets:[{label:'Income',data:ins,backgroundColor:'#27ae83',borderRadius:6},{label:'Expenses',data:outs,backgroundColor:'#f07868',borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,grid:{color:'#eef0f5'}}}}});
new Chart(document.getElementById('categoryChart'),{type:'doughnut',data:{labels:cats,datasets:[{data:vals,backgroundColor:['#496fd8','#27ae83','#f1b95b','#e77e70','#8b79d6','#5aabc0','#b2c66b','#d38da9','#8a9aab','#e0a15b'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'68%',plugins:{legend:{position:'bottom'}}}});
</script></body></html>
