<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="nav.jspf" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transactions · Pennywise</title><link rel="stylesheet" href="${ctx}/assets/css/app.css"></head><body><main class="main"><div class="page-head"><div><p class="eyebrow">MONEY IN / MONEY OUT</p><h1>Transactions</h1><p class="muted">Record and review your activity.</p></div></div>
<section class="panel"><h2>Add a transaction</h2><form class="transaction-form" method="post" action="${ctx}/transaction/save"><input type="hidden" name="csrfToken" value="${csrf}"><label>Type<select name="type"><option value="EXPENSE">Expense</option><option value="INCOME">Income</option></select></label><label>Description<input name="title" maxlength="150" required placeholder="e.g. Groceries"></label><label>Amount (₹)<input name="amount" type="number" min="0.01" step="0.01" required placeholder="0.00"></label><label>Date<input name="date" type="date" required></label><label>Category<select name="categoryId"><option value="">No category</option><c:forEach items="${categories}" var="c"><option value="${c.category_id}"><c:out value="${c.category_name}"/> (<c:out value="${c.category_type}"/>)</option></c:forEach></select></label><button class="btn primary">Save transaction</button></form></section>
<section class="panel"><h2>Expenses</h2><div class="table-scroll"><table><thead><tr><th>Description</th><th>Category</th><th>Date</th><th class="right">Amount</th><th></th></tr></thead><tbody><c:forEach items="${expenses}" var="t"><tr><td><c:out value="${t.title}"/></td><td><c:out value="${t.category}"/></td><td><c:out value="${t.tx_date}"/></td><td class="right red">− ₹ <c:out value="${t.amount}"/></td><td><form method="post" action="${ctx}/transaction/delete"><input type="hidden" name="csrfToken" value="${csrf}"><input type="hidden" name="type" value="EXPENSE"><input type="hidden" name="id" value="${t.id}"><button class="text-button">Delete</button></form></td></tr></c:forEach><c:if test="${empty expenses}"><tr><td colspan="5" class="empty">No expenses yet.</td></tr></c:if></tbody></table></div></section>
<section class="panel"><h2>Income</h2><div class="table-scroll"><table><thead><tr><th>Description</th><th>Category</th><th>Date</th><th class="right">Amount</th><th></th></tr></thead><tbody><c:forEach items="${incomes}" var="t"><tr><td><c:out value="${t.title}"/></td><td><c:out value="${t.category}"/></td><td><c:out value="${t.tx_date}"/></td><td class="right green">+ ₹ <c:out value="${t.amount}"/></td><td><form method="post" action="${ctx}/transaction/delete"><input type="hidden" name="csrfToken" value="${csrf}"><input type="hidden" name="type" value="INCOME"><input type="hidden" name="id" value="${t.id}"><button class="text-button">Delete</button></form></td></tr></c:forEach><c:if test="${empty incomes}"><tr><td colspan="5" class="empty">No income yet.</td></tr></c:if></tbody></table></div></section></main></body></html>
